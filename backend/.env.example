# Copy file này thành .env rồi sửa cho đúng máy của bạn:
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# KHÔNG commit file .env lên git (đã có trong .gitignore).

APP_NAME=T1 Shop EC API
APP_ENV=development

# ---- MySQL ----
# Điền giống thông tin bạn dùng để kết nối trong MySQL Workbench
# (Workbench: chuột phải vào connection -> Edit Connection để xem Hostname/Port/Username).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Mật khẩu root bạn đặt lúc cài MySQL (XAMPP mặc định để trống)
DB_PASSWORD=
DB_NAME=t1shop_db

# ---- Authentication ----
# Replace this development value with a unique random secret outside local development.
JWT_SECRET=replace-this-with-a-random-secret-before-deploy
JWT_ISSUER=t1shop-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional: creates an initial administrator during database setup when both are set.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=T1 Shop Admin

# ---- CORS ----
# Các địa chỉ frontend được phép gọi API, cách nhau bằng dấu phẩy.
# "*" = cho phép tất cả (tiện khi học/dev). Khi deploy thật hãy ghi rõ domain FE.
# Ví dụ: CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
CORS_ORIGINS=*

# ---- Product images ----
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_BYTES=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
