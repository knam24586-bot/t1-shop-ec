# Copy file này thành .env rồi sửa cho đúng máy của bạn:
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# KHÔNG commit file .env lên git (đã có trong .gitignore).

APP_NAME=T1 Shop EC API

# ---- MySQL Docker (quy trình khởi tạo chuẩn) ----
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=t1shop_db
MYSQL_ROOT_PASSWORD=local-root-password

# Tạo secret riêng: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Dữ liệu demo được thêm bằng `python -m app.db.bootstrap`.
# Đổi mật khẩu mẫu trước khi chia sẻ môi trường; seed chỉ lưu password hash.
SEED_DEMO_USER_EMAIL=demo@t1shop.local
SEED_DEMO_USER_NAME=T1Shop Demo Customer
SEED_DEMO_USER_PASSWORD=change-this-local-demo-password

# ---- CORS ----
# Các địa chỉ frontend được phép gọi API, cách nhau bằng dấu phẩy.
# "*" = cho phép tất cả (tiện khi học/dev). Khi deploy thật hãy ghi rõ domain FE.
# Ví dụ: CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
CORS_ORIGINS=*

# ---- Product images ----
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_BYTES=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
